        "textContent": "\n\t\t\tReihenbrecher\n\t\t\tLinecracker\n\t\t\tRompefilas\n\t\t\tRompefilas\n\t\t\tBrute forcenée\n\t\t\tFendiranghi\n\t\t\t前線崩し\n\t\t\t박살마\n\t\t\tŁamacz szeregów\n\t\t\tDestroçador de Defesas\n\t\t\tПробойник\n\t\t\tไลน์แครกเกอร์\n\t\t\t阵线破坏者\n\t\t\t戰線擊破者\n\t\t"
      },
      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Überwältigen: </b>\nVerdoppelt den Angriff dieses Dieners."
          },
          "enUS": {
            "present": true,
            "value": "<b>Overkill:</b> Double this minion's Attack."
          },
          "esES": {
            "present": true,
            "value": "[x]<b>Arrasar:</b>\nDuplica el ataque\nde este esbirro."
          },
          "esMX": {
            "present": true,
            "value": "<b>Arrasar:</b> duplica el Ataque de este esbirro."
          },
          "frFR": {
            "present": true,
            "value": "<b>Brutalité :</b> double l’Attaque de ce serviteur."
          },
          "itIT": {
            "present": true,
            "value": "[x]<b>Annientamento:</b>\nraddoppia l'Attacco\ndi questo servitore."
          },
          "jaJP": {
            "present": true,
            "value": "[x]<b>血祭:</b>\nこのミニオンの\n__攻撃力を2倍にする。"
          },
          "koKR": {
            "present": true,
            "value": "<b>압살:</b> 이 하수인의 공격력이 2배가 됩니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Rzeź:</b> Podwój atak tego stronnika."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Massacre:</b> Dobre o Ataque deste lacaio."
          },
          "ruRU": {
            "present": true,
            "value": "<b>Сверхурон:</b> удваивает свою атаку."
          },
          "thTH": {
            "present": true,
            "value": "<b>สังหารโหด:</b> เพิ่มพลังโจมตีของมินเนี่ยน[b]ตัวนี้เป็นสองเท่า"
          },
          "zhCN": {
            "present": true,
            "value": "<b>超杀：</b>使该随从的攻击力翻倍。"
          },
          "zhTW": {
            "present": true,
            "value": "<b>滅殺：</b>此手下的\n攻擊力加倍"
          }
        },
        "textContent": "\n\t\t\t<b>Überwältigen: </b>\nVerdoppelt den Angriff dieses Dieners.\n\t\t\t<b>Overkill:</b> Double this minion's Attack.\n\t\t\t[x]<b>Arrasar:</b>\nDuplica el ataque\nde este esbirro.\n\t\t\t<b>Arrasar:</b> duplica el Ataque de este esbirro.\n\t\t\t<b>Brutalité :</b> double l’Attaque de ce serviteur.\n\t\t\t[x]<b>Annientamento:</b>\nraddoppia l'Attacco\ndi questo servitore.\n\t\t\t[x]<b>血祭:</b>\nこのミニオンの\n__攻撃力を2倍にする。\n\t\t\t<b>압살:</b> 이 하수인의 공격력이 2배가 됩니다.\n\t\t\t<b>Rzeź:</b> Podwój atak tego stronnika.\n\t\t\t<b>Massacre:</b> Dobre o Ataque deste lacaio.\n\t\t\t<b>Сверхурон:</b> удваивает свою атаку.\n\t\t\t<b>สังหารโหด:</b> เพิ่มพลังโจมตีของมินเนี่ยน[b]ตัวนี้เป็นสองเท่า\n\t\t\t<b>超杀：</b>使该随从的攻击力翻倍。\n\t\t\t<b>滅殺：</b>此手下的\n攻擊力加倍\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Ihm liegen die Leute <i>reihenweise</i> zu Füßen."
          },
          "enUS": {
            "present": true,
            "value": "\"Tell me if you’ve heard this one!\""
          },
          "esES": {
            "present": true,
            "value": "Su superior dijo «¡Rompan filas!» y no ha parado desde entonces."
          },
          "esMX": {
            "present": true,
            "value": "Tiene la entrada prohibida en decenas de supermercados."
          },
          "frFR": {
            "present": true,
            "value": "Vous avez déjà vu « Le Loa, la brute et le cinglé » ?"
          },
          "itIT": {
            "present": true,
            "value": "\"NON serrate i ranghi!\""
          },
          "jaJP": {
            "present": true,
            "value": "前線崩して全線制する。"
          },
          "koKR": {
            "present": true,
            "value": "다른 이름은 '깨부숴주마'입니다."
          },
          "plPL": {
            "present": true,
            "value": "Lubi siać zamęt w uporządkowanych strukturach."
          },
          "ptBR": {
            "present": true,
            "value": "Todo mundo sempre falou que ele leva muito jeito pra ser promotor de justiça."
          },
          "ruRU": {
            "present": true,
            "value": "Друзья ценят его за прямолинейность: он всегда прет только вперед."
          },
          "thTH": {
            "present": true,
            "value": "ตีให้ถึงดวงจันทร์ ถึงพลาดก็ยังกำจัดได้หลายตัว"
          },
          "zhCN": {
            "present": true,
            "value": "哇喔，多么漂亮的一记挥杆！"
          },
          "zhTW": {
            "present": true,
            "value": "[問卦] 慟！食人妖戰線是不是被一個人擊破了？"
          }
        },
        "textContent": "\n\t\t\tIhm liegen die Leute <i>reihenweise</i> zu Füßen.\n\t\t\t\"Tell me if you’ve heard this one!\"\n\t\t\tSu superior dijo «¡Rompan filas!» y no ha parado desde entonces.\n\t\t\tTiene la entrada prohibida en decenas de supermercados.\n\t\t\tVous avez déjà vu « Le Loa, la brute et le cinglé » ?\n\t\t\t\"NON serrate i ranghi!\"\n\t\t\t前線崩して全線制する。\n\t\t\t다른 이름은 '깨부숴주마'입니다.\n\t\t\tLubi siać zamęt w uporządkowanych strukturach.\n\t\t\tTodo mundo sempre falou que ele leva muito jeito pra ser promotor de justiça.\n\t\t\tДрузья ценят его за прямолинейность: он всегда прет только вперед.\n\t\t\tตีให้ถึงดวงจันทร์ ถึงพลาดก็ยังกำจัดได้หลายตัว\n\t\t\t哇喔，多么漂亮的一记挥杆！\n\t\t\t[問卦] 慟！食人妖戰線是不是被一個人擊破了？\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Paul Mafayon"
      }
    },
