      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Kampfschrei:</b>\nFügt Eurem Helden 5_Schaden zu."
          },
          "enUS": {
            "present": true,
            "value": "<b>Battlecry:</b> Deal 5 damage to your hero."
          },
          "esES": {
            "present": true,
            "value": "[x]<b>Grito de batalla:</b>\nInflige 5 p. de daño\na tu héroe."
          },
          "esMX": {
            "present": true,
            "value": "<b>Grito de batalla:</b> inflige 5 de daño a tu héroe."
          },
          "frFR": {
            "present": true,
            "value": "<b>Cri de guerre :</b> inflige 5_points de dégâts à votre héros."
          },
          "itIT": {
            "present": true,
            "value": "[x]<b>Grido di Battaglia:</b>\ninfligge 5 danni\nal tuo eroe."
          },
          "jaJP": {
            "present": true,
            "value": "[x]<b>雄叫び:</b>\n自分のヒーローに\n______5ダメージを与える。"
          },
          "koKR": {
            "present": true,
            "value": "[x]<b>전투의 함성:</b>\n내 영웅에게 피해를\n5 줍니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Okrzyk bojowy:</b> Zadaj\n5 pkt. obrażeń twojemu bohaterowi."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Grito de Guerra:</b> \nCause 5 de dano ao seu herói."
          },
          "ruRU": {
            "present": true,
            "value": "<b>Боевой клич:</b>\nнаносит 5 ед. урона вашему герою."
          },
          "thTH": {
            "present": true,
            "value": "<b>คำรามสู้ศึก:</b> สร้างความเสียหาย_5_แต้ม[b]ให้ฮีโร่ของคุณ"
          },
          "zhCN": {
            "present": true,
            "value": "<b>战吼：</b>对你的英雄造成5点伤害。"
          },
          "zhTW": {
            "present": true,
            "value": "<b>戰吼：</b>對你的英雄造成5點傷害"
          }
        },
        "textContent": "\n\t\t\t<b>Kampfschrei:</b>\nFügt Eurem Helden 5_Schaden zu.\n\t\t\t<b>Battlecry:</b> Deal 5 damage to your hero.\n\t\t\t[x]<b>Grito de batalla:</b>\nInflige 5 p. de daño\na tu héroe.\n\t\t\t<b>Grito de batalla:</b> inflige 5 de daño a tu héroe.\n\t\t\t<b>Cri de guerre :</b> inflige 5_points de dégâts à votre héros.\n\t\t\t[x]<b>Grido di Battaglia:</b>\ninfligge 5 danni\nal tuo eroe.\n\t\t\t[x]<b>雄叫び:</b>\n自分のヒーローに\n______5ダメージを与える。\n\t\t\t[x]<b>전투의 함성:</b>\n내 영웅에게 피해를\n5 줍니다.\n\t\t\t<b>Okrzyk bojowy:</b> Zadaj\n5 pkt. obrażeń twojemu bohaterowi.\n\t\t\t<b>Grito de Guerra:</b> \nCause 5 de dano ao seu herói.\n\t\t\t<b>Боевой клич:</b>\nнаносит 5 ед. урона вашему герою.\n\t\t\t<b>คำรามสู้ศึก:</b> สร้างความเสียหาย_5_แต้ม[b]ให้ฮีโร่ของคุณ\n\t\t\t<b>战吼：</b>对你的英雄造成5点伤害。\n\t\t\t<b>戰吼：</b>對你的英雄造成5點傷害\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Mehr ein Kopf als eine Klaue_... aber was soll's."
          },
          "enUS": {
            "present": true,
            "value": "This weapon – ow! Requires a little – OWW! Finesse."
          },
          "esES": {
            "present": true,
            "value": "Es un ar... ¡ay!... arma que hay que... ¡ay!... manipular con... ¡ay!... con cuidado."
          },
          "esMX": {
            "present": true,
            "value": "Esta arma... ¡Au! Necesita un poco de... ¡AUCH! Estilo."
          },
          "frFR": {
            "present": true,
            "value": "Quand on attrape un félin par la queue, il sort les griffes !"
          },
          "itIT": {
            "present": true,
            "value": "\"L'ho smussata un pochettino perché mi dà fastidio mentre cammino.\""
          },
          "jaJP": {
            "present": true,
            "value": "この武器を――痛ッ！…使いこなすには――ぐぇっ！…腕が必要さー。"
          },
          "koKR": {
            "present": true,
            "value": "이 무기는... 아야! 아주 섬세하게... 아야! 다뤄야 한다고."
          },
          "plPL": {
            "present": true,
            "value": "Władanie tą bronią – auć! – wymaga odrobiny – ała! – precyzji."
          },
          "ptBR": {
            "present": true,
            "value": "Esta arma — ai! — podia ser mais — AAAI! — refinada."
          },
          "ruRU": {
            "present": true,
            "value": "Изначально использовался в качестве чесалки."
          },
          "thTH": {
            "present": true,
            "value": "จะใช้อาวุธชิ้นนี้-โอ๊ย! ต้องมีความ-โอ๊ยย! คล่องแคล่ว"
          },
          "zhCN": {
            "present": true,
            "value": "快使用*哎呀*……血爪，哼哼哈*哎呀*嘿！"
          },
          "zhTW": {
            "present": true,
            "value": "這把武器－－噢！用起來要很小－－呃啊！心…"
          }
        },
        "textContent": "\n\t\t\tMehr ein Kopf als eine Klaue_... aber was soll's.\n\t\t\tThis weapon – ow! Requires a little – OWW! Finesse.\n\t\t\tEs un ar... ¡ay!... arma que hay que... ¡ay!... manipular con... ¡ay!... con cuidado.\n\t\t\tEsta arma... ¡Au! Necesita un poco de... ¡AUCH! Estilo.\n\t\t\tQuand on attrape un félin par la queue, il sort les griffes !\n\t\t\t\"L'ho smussata un pochettino perché mi dà fastidio mentre cammino.\"\n\t\t\tこの武器を――痛ッ！…使いこなすには――ぐぇっ！…腕が必要さー。\n\t\t\t이 무기는... 아야! 아주 섬세하게... 아야! 다뤄야 한다고.\n\t\t\tWładanie tą bronią – auć! – wymaga odrobiny – ała! – precyzji.\n\t\t\tEsta arma — ai! — podia ser mais — AAAI! — refinada.\n\t\t\tИзначально использовался в качестве чесалки.\n\t\t\tจะใช้อาวุธชิ้นนี้-โอ๊ย! ต้องมีความ-โอ๊ยย! คล่องแคล่ว\n\t\t\t快使用*哎呀*……血爪，哼哼哈*哎呀*嘿！\n\t\t\t這把武器－－噢！用起來要很小－－呃啊！心…\n\t\t"
      },
