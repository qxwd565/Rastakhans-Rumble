          "koKR": {
            "present": true,
            "value": "일반 카드지만 스테이크는 레어입니다."
          },
          "plPL": {
            "present": true,
            "value": "Stek na grocie to w niektórych stronach prawdziwy przysmak."
          },
          "ptBR": {
            "present": true,
            "value": "Alguém entendeu errado quando disseram \"Manda uma carne bem rápido\"."
          },
          "ruRU": {
            "present": true,
            "value": "Новейшая охотничья уловка."
          },
          "thTH": {
            "present": true,
            "value": "การ์ดนี้เป็นระดับคอมม่อน แต่สเต็กระดับแรร์"
          },
          "zhCN": {
