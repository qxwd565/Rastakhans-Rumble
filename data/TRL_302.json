        "locales": {
          "deDE": {
            "present": true,
            "value": "Euer Held ist bis zu Eurem nächsten Zug <b>immun</b>."
          },
          "enUS": {
            "present": true,
            "value": "Your hero is <b>Immune</b> until your next turn."
          },
          "esES": {
            "present": true,
            "value": "[x]Tu héroe es <b>inmune</b>\nhasta el próximo turno."
          },
          "esMX": {
            "present": true,
            "value": "Tu héroe es <b>Inmune</b> hasta_tu_próximo_turno."
          },
          "frFR": {
            "present": true,
            "value": "Votre héros est <b>Insensible</b> jusqu’à votre prochain tour."
          },
          "itIT": {
            "present": true,
            "value": "Il tuo eroe è <b>Immune</b> fino al tuo turno successivo."
          },
          "jaJP": {
            "present": true,
            "value": "[x]自分のヒーローは次の\n_自分のターンまで<b>無敵</b>。"
          },
          "koKR": {
            "present": true,
            "value": "내 다음 턴까지 내 영웅이 <b>면역</b> 상태가 됩니다."
          },
          "plPL": {
            "present": true,
            "value": "Twój bohater posiada <b>Niewrażliwość</b> do twojej następnej tury."
          },
          "ptBR": {
            "present": true,
            "value": "Seu herói fica <b>Imune</b> até seu próximo turno."
          },
          "ruRU": {
            "present": true,
            "value": "Ваш герой <b>неуязвим</b> до вашего следующего хода."
          },
          "thTH": {
            "present": true,
            "value": "ฮีโร่ของคุณ <b>คงกระพัน</b> จนถึงเทิร์นถัดไปของคุณ"
          },
          "zhCN": {
            "present": true,
            "value": "直到你的下个回合，你的英雄获得<b>免疫</b>。"
          },
          "zhTW": {
            "present": true,
            "value": "你的英雄\n<b>免疫</b>，直到你的\n下一回合"
          }
        },
        "textContent": "\n\t\t\tEuer Held ist bis zu Eurem nächsten Zug <b>immun</b>.\n\t\t\tYour hero is <b>Immune</b> until your next turn.\n\t\t\t[x]Tu héroe es <b>inmune</b>\nhasta el próximo turno.\n\t\t\tTu héroe es <b>Inmune</b> hasta_tu_próximo_turno.\n\t\t\tVotre héros est <b>Insensible</b> jusqu’à votre prochain tour.\n\t\t\tIl tuo eroe è <b>Immune</b> fino al tuo turno successivo.\n\t\t\t[x]自分のヒーローは次の\n_自分のターンまで<b>無敵</b>。\n\t\t\t내 다음 턴까지 내 영웅이 <b>면역</b> 상태가 됩니다.\n\t\t\tTwój bohater posiada <b>Niewrażliwość</b> do twojej następnej tury.\n\t\t\tSeu herói fica <b>Imune</b> até seu próximo turno.\n\t\t\tВаш герой <b>неуязвим</b> до вашего следующего хода.\n\t\t\tฮีโร่ของคุณ <b>คงกระพัน</b> จนถึงเทิร์นถัดไปของคุณ\n\t\t\t直到你的下个回合，你的英雄获得<b>免疫</b>。\n\t\t\t你的英雄\n<b>免疫</b>，直到你的\n下一回合\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Toll für Basketball und Eishockey, aber nutzlos beim Fußball."
          },
          "enUS": {
            "present": true,
            "value": "Highly effective against 3 year olds."
          },
          "esES": {
            "present": true,
            "value": "No es la forma más fina de anunciar que ha muerto un meteorólogo."
          },
          "esMX": {
            "present": true,
            "value": "Háblale a la mano."
          },
          "frFR": {
            "present": true,
            "value": "Aussi très utile lors d’évènements sportifs."
          },
          "itIT": {
            "present": true,
            "value": "Arimus!"
          },
          "jaJP": {
            "present": true,
            "value": "いや、残念ながら飛び道具は反射できない。消せるだけだ。"
          },
          "koKR": {
            "present": true,
            "value": "세 살배기 아이들을 상대할 때 효과적입니다."
          },
          "plPL": {
            "present": true,
            "value": "„A po przerwie wracamy do mordobicia!”."
          },
          "ptBR": {
            "present": true,
            "value": "Às vezes usado em competições, como basquete, vôlei e relacionamentos amorosos."
          },
          "ruRU": {
            "present": true,
            "value": "Сделай паузу — скушай... РУЛЕТ."
          },
          "thTH": {
            "present": true,
            "value": "ได้ผลดีเป็นพิเศษกับเด็ก 3 ขวบ"
          },
          "zhCN": {
            "present": true,
            "value": "这就是……圣骑士的绝对领域吗？！"
          },
          "zhTW": {
            "present": true,
            "value": "「閃電！你不可以碰我！」"
          }
        },
        "textContent": "\n\t\t\tToll für Basketball und Eishockey, aber nutzlos beim Fußball.\n\t\t\tHighly effective against 3 year olds.\n\t\t\tNo es la forma más fina de anunciar que ha muerto un meteorólogo.\n\t\t\tHáblale a la mano.\n\t\t\tAussi très utile lors d’évènements sportifs.\n\t\t\tArimus!\n\t\t\tいや、残念ながら飛び道具は反射できない。消せるだけだ。\n\t\t\t세 살배기 아이들을 상대할 때 효과적입니다.\n\t\t\t„A po przerwie wracamy do mordobicia!”.\n\t\t\tÀs vezes usado em competições, como basquete, vôlei e relacionamentos amorosos.\n\t\t\tСделай паузу — скушай... РУЛЕТ.\n\t\t\tได้ผลดีเป็นพิเศษกับเด็ก 3 ขวบ\n\t\t\t这就是……圣骑士的绝对领域吗？！\n\t\t\t「閃電！你不可以碰我！」\n\t\t"
      },
