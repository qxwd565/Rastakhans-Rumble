      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Zieht ein Wildtier aus Eurem Deck. Verdoppelt sein Leben."
          },
          "enUS": {
            "present": true,
            "value": "[x]Draw a Beast from your\ndeck. Double its Health."
          },
          "esES": {
            "present": true,
            "value": "Roba una bestia\nde tu mazo.\nDuplica su salud."
          },
          "esMX": {
            "present": true,
            "value": "Roba una Bestia de tu mazo._Duplica_su_salud."
          },
          "frFR": {
            "present": true,
            "value": "Vous piochez une Bête dans votre deck. Double_ses_PV."
          },
          "itIT": {
            "present": true,
            "value": "Pesca una Bestia dal tuo mazzo. Raddoppia la sua Salute."
          },
          "jaJP": {
            "present": true,
            "value": "自分のデッキから獣を1体引く。その獣の体力を\n2倍にする。"
          },
          "koKR": {
            "present": true,
            "value": "[x]내 덱에서\n야수를 뽑습니다.\n그 야수의 생명력을\n2배 증가시킵니다."
          },
          "plPL": {
            "present": true,
            "value": "Dobierz Bestię\nz twojej talii. Podwój jej_zdrowie."
          },
          "ptBR": {
            "present": true,
            "value": "Compre uma \nFera do seu deck. Dobre a Vida dela."
          },
          "ruRU": {
            "present": true,
            "value": "Вы берете зверя_из_колоды. Его здоровье удваивается."
          },
          "thTH": {
            "present": true,
            "value": "_จั่วการ์ดสัตว์หนึ่งใบจาก_[b]เด็คคุณ_เพิ่มพลังชีวิต[b]ของมันเป็นสองเท่า"
          },
          "zhCN": {
            "present": true,
            "value": "从你的牌库中抽一张野兽牌。将其生命值翻倍。"
          },
          "zhTW": {
            "present": true,
            "value": "從你的牌堆\n抽出一張野獸，並使其生命值加倍"
          }
        },
        "textContent": "\n\t\t\tZieht ein Wildtier aus Eurem Deck. Verdoppelt sein Leben.\n\t\t\t[x]Draw a Beast from your\ndeck. Double its Health.\n\t\t\tRoba una bestia\nde tu mazo.\nDuplica su salud.\n\t\t\tRoba una Bestia de tu mazo._Duplica_su_salud.\n\t\t\tVous piochez une Bête dans votre deck. Double_ses_PV.\n\t\t\tPesca una Bestia dal tuo mazzo. Raddoppia la sua Salute.\n\t\t\t自分のデッキから獣を1体引く。その獣の体力を\n2倍にする。\n\t\t\t[x]내 덱에서\n야수를 뽑습니다.\n그 야수의 생명력을\n2배 증가시킵니다.\n\t\t\tDobierz Bestię\nz twojej talii. Podwój jej_zdrowie.\n\t\t\tCompre uma \nFera do seu deck. Dobre a Vida dela.\n\t\t\tВы берете зверя_из_колоды. Его здоровье удваивается.\n\t\t\t_จั่วการ์ดสัตว์หนึ่งใบจาก_[b]เด็คคุณ_เพิ่มพลังชีวิต[b]ของมันเป็นสองเท่า\n\t\t\t从你的牌库中抽一张野兽牌。将其生命值翻倍。\n\t\t\t從你的牌堆\n抽出一張野獸，並使其生命值加倍\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "„Keine Panik, das ist nichts weiter. Ihr habt seinen Jagdinstinkt geweckt, alles ganz harmlos.“ – „Und was mach ich jetzt?“ – „Warten, bis er zu Ende gejagt hat. Viel Glück!“"
          },
          "enUS": {
            "present": true,
            "value": "Somebody’s been eating their funnel cakes."
          },
          "esES": {
            "present": true,
            "value": "Alguien se ha comido sus churros."
          },
          "esMX": {
            "present": true,
            "value": "Alguien ha estado comiendo muchas tortas de azúcar."
          },
          "frFR": {
            "present": true,
            "value": "Je suis dans votre arène, à manger vos Trolls !"
          },
          "itIT": {
            "present": true,
            "value": "Qualcuno qui ha mangiato tutto il tiramisauro."
          },
          "jaJP": {
            "present": true,
            "value": "引いた獣を食うのか、食われるのか。それが問題だ。"
          },
          "koKR": {
            "present": true,
            "value": "누가 녀석의 먹거리를 훔쳐먹었나 봅니다."
          },
          "plPL": {
            "present": true,
            "value": "Ktoś tu się obżerał faworkami."
          },
          "ptBR": {
            "present": true,
            "value": "Desse jeito, vão ter que mudar para a ração de castrados."
          },
          "ruRU": {
            "present": true,
            "value": "«Кто съел мой рулетик?!»"
          },
          "thTH": {
            "present": true,
            "value": "อย่าปล่อยให้ความหิวครอบงำคุณ"
          },
          "zhCN": {
            "present": true,
            "value": "先来两个开胃菜。"
          },
          "zhTW": {
            "present": true,
            "value": "肉好，肉多更好！"
          }
        },
        "textContent": "\n\t\t\t„Keine Panik, das ist nichts weiter. Ihr habt seinen Jagdinstinkt geweckt, alles ganz harmlos.“ – „Und was mach ich jetzt?“ – „Warten, bis er zu Ende gejagt hat. Viel Glück!“\n\t\t\tSomebody’s been eating their funnel cakes.\n\t\t\tAlguien se ha comido sus churros.\n\t\t\tAlguien ha estado comiendo muchas tortas de azúcar.\n\t\t\tJe suis dans votre arène, à manger vos Trolls !\n\t\t\tQualcuno qui ha mangiato tutto il tiramisauro.\n\t\t\t引いた獣を食うのか、食われるのか。それが問題だ。\n\t\t\t누가 녀석의 먹거리를 훔쳐먹었나 봅니다.\n\t\t\tKtoś tu się obżerał faworkami.\n\t\t\tDesse jeito, vão ter que mudar para a ração de castrados.\n\t\t\t«Кто съел мой рулетик?!»\n\t\t\tอย่าปล่อยให้ความหิวครอบงำคุณ\n\t\t\t先来两个开胃菜。\n\t\t\t肉好，肉多更好！\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Clint Langley"
      }
    },
