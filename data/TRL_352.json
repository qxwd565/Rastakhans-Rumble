        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Hat +2 Angriff, wenn Ihr [x]<b>überladene</b> Mana[d]kristalle habt."
          },
          "enUS": {
            "present": true,
            "value": "Has +2 Attack while you have <b>Overloaded</b> Mana Crystals."
          },
          "esES": {
            "present": true,
            "value": "Tiene +2 p. de ataque mientras tengas\ncristales de maná <b>sobrecargados</b>."
          },
          "esMX": {
            "present": true,
            "value": "Tiene +2 de Ataque mientras tengas Cristales de maná <b>Sobrecargados</b>."
          },
          "frFR": {
            "present": true,
            "value": "A +2_ATQ tant que vous avez  des cristaux de mana_en_<b>Surcharge</b>."
          },
          "itIT": {
            "present": true,
            "value": "[x]Ha +2 Attacco finché hai\ndei Cristalli di Mana\nin <b>Sovraccarico</b>."
          },
          "jaJP": {
            "present": true,
            "value": "[x]自分のマナクリスタルが\n<b>オーバーロード</b>\nしている場合\n___攻撃力+2を得る。"
          },
          "koKR": {
            "present": true,
            "value": "내 마나 수정이 <b>과부하</b>된 동안 공격력을 +2 얻습니다."
          },
          "plPL": {
            "present": true,
            "value": "Ma +2 do ataku, jeśli masz_<b>Przeciążone</b> kryształy many."
          },
          "ptBR": {
            "present": true,
            "value": "Ganha +2 de Ataque enquanto você tiver \nCristais de Mana <b>Sobrecarregados</b>."
          },
          "ruRU": {
            "present": true,
            "value": "Получает +2 к атаке, пока у вас есть <b>перегруженные</b> кристаллы маны."
          },
          "thTH": {
            "present": true,
            "value": "พลังโจมตี_+2_ระหว่างที่[b]คริสตัลมานาของคุณ <b>โอเวอร์โหลด</b>"
          },
          "zhCN": {
            "present": true,
            "value": "当你有<b>过载</b>的法力水晶时，获得+2攻击力。"
          },
          "zhTW": {
            "present": true,
            "value": "[x]若你有<b>超載</b>的\n法力水晶，獲得\n+2攻擊力"
          }
        },
        "textContent": "\n\t\t\tHat +2 Angriff, wenn Ihr [x]<b>überladene</b> Mana[d]kristalle habt.\n\t\t\tHas +2 Attack while you have <b>Overloaded</b> Mana Crystals.\n\t\t\tTiene +2 p. de ataque mientras tengas\ncristales de maná <b>sobrecargados</b>.\n\t\t\tTiene +2 de Ataque mientras tengas Cristales de maná <b>Sobrecargados</b>.\n\t\t\tA +2_ATQ tant que vous avez  des cristaux de mana_en_<b>Surcharge</b>.\n\t\t\t[x]Ha +2 Attacco finché hai\ndei Cristalli di Mana\nin <b>Sovraccarico</b>.\n\t\t\t[x]自分のマナクリスタルが\n<b>オーバーロード</b>\nしている場合\n___攻撃力+2を得る。\n\t\t\t내 마나 수정이 <b>과부하</b>된 동안 공격력을 +2 얻습니다.\n\t\t\tMa +2 do ataku, jeśli masz_<b>Przeciążone</b> kryształy many.\n\t\t\tGanha +2 de Ataque enquanto você tiver \nCristais de Mana <b>Sobrecarregados</b>.\n\t\t\tПолучает +2 к атаке, пока у вас есть <b>перегруженные</b> кристаллы маны.\n\t\t\tพลังโจมตี_+2_ระหว่างที่[b]คริสตัลมานาของคุณ <b>โอเวอร์โหลด</b>\n\t\t\t当你有<b>过载</b>的法力水晶时，获得+2攻击力。\n\t\t\t[x]若你有<b>超載</b>的\n法力水晶，獲得\n+2攻擊力\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Neeein! Nein! Schlagt Euch das gleich wieder aus dem Kopf!"
          },
          "enUS": {
            "present": true,
            "value": "\"I double frog dare you!\""
          },
          "esES": {
            "present": true,
            "value": "Si no estás luchando, también la puedes utilizar para pegar sellos."
          },
          "esMX": {
            "present": true,
            "value": "\"¡Saluden al hipnosapo!\""
          },
          "frFR": {
            "present": true,
            "value": "Pour faire de la lèche, c’est le roi !"
          },
          "itIT": {
            "present": true,
            "value": "Il nuovo gusto dell'estate a Dazar'alor!"
          },
          "jaJP": {
            "present": true,
            "value": "ゲロゲ～ロ　ゲロゲ～ロ\nベロベ～ロ　ベロベ～ロ"
          },
          "koKR": {
            "present": true,
            "value": "강아지들이 좋아합니다."
          },
          "plPL": {
            "present": true,
            "value": "Nawet nie zauważysz, jak wyrwie ci jedzenie z dłoni."
          },
          "ptBR": {
            "present": true,
            "value": "O pior dano é o da lambida."
          },
          "ruRU": {
            "present": true,
            "value": "Студенистый. Склизкий. Твой."
          },
          "thTH": {
            "present": true,
            "value": "เล่นกับกบ กบเลียปาก"
          },
          "zhCN": {
            "present": true,
            "value": "什么？只要过载就能提高2点攻击力？那还不舔爆？！"
          },
          "zhTW": {
            "present": true,
            "value": "超載啦！那我還不舔爆！"
          }
        },
        "textContent": "\n\t\t\tNeeein! Nein! Schlagt Euch das gleich wieder aus dem Kopf!\n\t\t\t\"I double frog dare you!\"\n\t\t\tSi no estás luchando, también la puedes utilizar para pegar sellos.\n\t\t\t\"¡Saluden al hipnosapo!\"\n\t\t\tPour faire de la lèche, c’est le roi !\n\t\t\tIl nuovo gusto dell'estate a Dazar'alor!\n\t\t\tゲロゲ～ロ　ゲロゲ～ロ\nベロベ～ロ　ベロベ～ロ\n\t\t\t강아지들이 좋아합니다.\n\t\t\tNawet nie zauważysz, jak wyrwie ci jedzenie z dłoni.\n\t\t\tO pior dano é o da lambida.\n\t\t\tСтуденистый. Склизкий. Твой.\n\t\t\tเล่นกับกบ กบเลียปาก\n\t\t\t什么？只要过载就能提高2点攻击力？那还不舔爆？！\n\t\t\t超載啦！那我還不舔爆！\n\t\t"
      },
