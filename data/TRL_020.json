            "value": "<b>속공</b>, <b>압살:</b> 1/1 박쥐를 2마리 소환합니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Zryw</b>\n<b>Rzeź:</b> Przyzwij dwa Nietoperze 1/1."
          },
          "ptBR": {
