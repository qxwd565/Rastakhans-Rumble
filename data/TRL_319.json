          },
          "ptBR": {
            "present": true,
            "value": "Precisão não é o forte dos falcodragos."
          },
          "ruRU": {
            "present": true,
            "value": "Всегда настигает цель. Какую-нибудь."
          },
          "thTH": {
            "present": true,
            "value": "ดราก้อนฮอว์คไม่ได้ขึ้นชื่อเรื่องความแม่นยำ"
          },
          "zhCN": {
