      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Fügt allen Dienern\n$2 Schaden zu. <b>Überwältigen:</b>\nErhaltet einen zufälligen\nMagierzauber auf die Hand."
          },
          "enUS": {
            "present": true,
            "value": "Deal $2 damage to_all minions.\n<b>Overkill</b>: Add a random Mage spell to your hand."
          },
          "esES": {
            "present": true,
            "value": "[x]Inflige $2 p. de daño\na todos los esbirros.\n<b>Arrasar:</b> Añade un hechizo\nde mago aleatorio\na tu mano."
          },
          "esMX": {
            "present": true,
            "value": "Inflige $2 de daño a todos los esbirros.\n<b>Arrasar</b>: agrega un hechizo de_Mago aleatorio a tu mano."
          },
          "frFR": {
            "present": true,
            "value": "Inflige $2_|4(point,points) de dégâts à tous les serviteurs.\n<b>Brutalité :</b> ajoute un sort de mage aléatoire dans votre main."
          },
          "itIT": {
            "present": true,
            "value": "[x]Infligge $2 danni a TUTTI\ni servitori. <b>Annientamento:</b>\nmette nella tua mano una\nMagia casuale del Mago."
          },
          "jaJP": {
            "present": true,
            "value": "全てのミニオンに\n$2ダメージを与える。\n<b>血祭:</b>ランダムなメイジの\n呪文1枚を自分の手札に追加する。"
          },
          "koKR": {
            "present": true,
            "value": "<b>모든</b> 하수인에게 피해를 $2 줍니다.\n<b>압살</b>: 무작위 마법사 주문을 내 손으로 가져옵니다."
          },
          "plPL": {
            "present": true,
            "value": "Zadaj $2 pkt. obrażeń wszystkim stronnikom.\n<b>Rzeź:</b> Dodaj losowe zaklęcie maga do_twojej ręki."
          },
          "ptBR": {
            "present": true,
            "value": "Cause $2 de dano a todos os lacaios. <b>Massacre:</b> Adicione um feitiço de Mago aleatório à sua mão."
          },
          "ruRU": {
            "present": true,
            "value": "Наносит $2 ед. урона всем существам. <b>Сверхурон:</b> вы кладете в руку случайное заклинание мага."
          },
          "thTH": {
            "present": true,
            "value": "สร้างความเสียหาย $2_แต้มให้มินเนี่ยนทั้งหมด <b>สังหารโหด</b>:_สุ่มเพิ่มเวทมนตร์[b]ของเมจหนึ่งใบในมือคุณ_"
          },
          "zhCN": {
            "present": true,
            "value": "对所有随从造成$2点伤害。<b>超杀</b>：随机将一张法师法术牌置入你的手牌。"
          },
          "zhTW": {
            "present": true,
            "value": "對全部手下造成\n$2點傷害\n<b>滅殺</b>：放一張隨機法師法術牌到你的手中"
          }
        },
        "textContent": "\n\t\t\tFügt allen Dienern\n$2 Schaden zu. <b>Überwältigen:</b>\nErhaltet einen zufälligen\nMagierzauber auf die Hand.\n\t\t\tDeal $2 damage to_all minions.\n<b>Overkill</b>: Add a random Mage spell to your hand.\n\t\t\t[x]Inflige $2 p. de daño\na todos los esbirros.\n<b>Arrasar:</b> Añade un hechizo\nde mago aleatorio\na tu mano.\n\t\t\tInflige $2 de daño a todos los esbirros.\n<b>Arrasar</b>: agrega un hechizo de_Mago aleatorio a tu mano.\n\t\t\tInflige $2_|4(point,points) de dégâts à tous les serviteurs.\n<b>Brutalité :</b> ajoute un sort de mage aléatoire dans votre main.\n\t\t\t[x]Infligge $2 danni a TUTTI\ni servitori. <b>Annientamento:</b>\nmette nella tua mano una\nMagia casuale del Mago.\n\t\t\t全てのミニオンに\n$2ダメージを与える。\n<b>血祭:</b>ランダムなメイジの\n呪文1枚を自分の手札に追加する。\n\t\t\t<b>모든</b> 하수인에게 피해를 $2 줍니다.\n<b>압살</b>: 무작위 마법사 주문을 내 손으로 가져옵니다.\n\t\t\tZadaj $2 pkt. obrażeń wszystkim stronnikom.\n<b>Rzeź:</b> Dodaj losowe zaklęcie maga do_twojej ręki.\n\t\t\tCause $2 de dano a todos os lacaios. <b>Massacre:</b> Adicione um feitiço de Mago aleatório à sua mão.\n\t\t\tНаносит $2 ед. урона всем существам. <b>Сверхурон:</b> вы кладете в руку случайное заклинание мага.\n\t\t\tสร้างความเสียหาย $2_แต้มให้มินเนี่ยนทั้งหมด <b>สังหารโหด</b>:_สุ่มเพิ่มเวทมนตร์[b]ของเมจหนึ่งใบในมือคุณ_\n\t\t\t对所有随从造成$2点伤害。<b>超杀</b>：随机将一张法师法术牌置入你的手牌。\n\t\t\t對全部手下造成\n$2點傷害\n<b>滅殺</b>：放一張隨機法師法術牌到你的手中\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Wenn du in Flammen stehst, dann klatsche in die Hand!"
          },
          "enUS": {
            "present": true,
            "value": "If you’re burning and you know it, wave your hands!"
          },
          "esES": {
            "present": true,
            "value": "Zambúllete, está calentita."
          },
          "esMX": {
            "present": true,
            "value": "¡A que no captas esta onda!"
          },
          "frFR": {
            "present": true,
            "value": "Les sorts lui brûlent les doigts."
          },
          "itIT": {
            "present": true,
            "value": "Se vai a fuoco e tu lo sai, scalda le mani!"
          },
          "jaJP": {
            "present": true,
            "value": "昔は炎を5色出せれば十分だったが、今ではシーズン中盤から追加戦士が登場するのが当たり前になっているのが、ステージメイジの密かな頭痛の種。"
          },
          "koKR": {
            "present": true,
            "value": "실례합니다만 지금 불타고들 계십니다."
          },
          "plPL": {
            "present": true,
            "value": "Uważaj, bo spali ci rzęsy!"
          },
          "ptBR": {
            "present": true,
            "value": "Ninguém quer surfar nessa onda."
          },
          "ruRU": {
            "present": true,
            "value": "Гасит... все живое."
          },
          "thTH": {
            "present": true,
            "value": "หากว่าเราโดนเผาด้วยไฟ จงโบกมือพลัน!"
          },
          "zhCN": {
            "present": true,
            "value": "如果感到燥热你就挥挥手！"
          },
          "zhTW": {
            "present": true,
            "value": "等場上有14個幽光，你就知道了！"
          }
        },
        "textContent": "\n\t\t\tWenn du in Flammen stehst, dann klatsche in die Hand!\n\t\t\tIf you’re burning and you know it, wave your hands!\n\t\t\tZambúllete, está calentita.\n\t\t\t¡A que no captas esta onda!\n\t\t\tLes sorts lui brûlent les doigts.\n\t\t\tSe vai a fuoco e tu lo sai, scalda le mani!\n\t\t\t昔は炎を5色出せれば十分だったが、今ではシーズン中盤から追加戦士が登場するのが当たり前になっているのが、ステージメイジの密かな頭痛の種。\n\t\t\t실례합니다만 지금 불타고들 계십니다.\n\t\t\tUważaj, bo spali ci rzęsy!\n\t\t\tNinguém quer surfar nessa onda.\n\t\t\tГасит... все живое.\n\t\t\tหากว่าเราโดนเผาด้วยไฟ จงโบกมือพลัน!\n\t\t\t如果感到燥热你就挥挥手！\n\t\t\t等場上有14個幽光，你就知道了！\n\t\t"
      },
