        "textContent": "\n\t\t\tDieb-Stahl\n\t\t\tStolen Steel\n\t\t\tAcero robado\n\t\t\tAcero robado\n\t\t\tBarbotage\n\t\t\tAcciaio Rubato\n\t\t\t盗んだナイフ\n\t\t\t훔친 강철\n\t\t\tSkradziona stal\n\t\t\tAço Roubado\n\t\t\tУкраденное оружие\n\t\t\tขโมยอาวุธ\n\t\t\t盗取武器\n\t\t\t偷竊兵器\n\t\t"
      },
      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Entdeckt</b> eine Waffe einer anderen Klasse."
          },
          "enUS": {
            "present": true,
            "value": "<b>Discover</b> a weapon <i>(from another class)</i>."
          },
          "esES": {
            "present": true,
            "value": "<b>Descubre</b> un arma\n<i>(de otra clase)</i>."
          },
          "esMX": {
            "present": true,
            "value": "<b>Devela</b> un arma \n<i>(de otra clase)</i>."
          },
          "frFR": {
            "present": true,
            "value": "<b>Découvre</b> une arme\n<i>(d’une autre classe)</i>."
          },
          "itIT": {
            "present": true,
            "value": "<b>Rinvieni</b> un'Arma di un'altra classe."
          },
          "jaJP": {
            "present": true,
            "value": "[x]<i>他のクラスの</i>\n武器を1つ<b>発見</b>する。"
          },
          "koKR": {
            "present": true,
            "value": "다른 직업의 무기를 <b>발견</b>합니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Odkryj</b> broń\n<i>(innej_klasy)</i>."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Descubra</b> uma arma <i>(de outra classe)</i>."
          },
          "ruRU": {
            "present": true,
            "value": "Вы <b>раскапываете</b> оружие <i>(другого класса)</i>."
          },
          "thTH": {
            "present": true,
            "value": "<b>ค้นพบ</b> อาวุธหนึ่งใบ <i>(ของคลาสอื่น)</i>"
          },
          "zhCN": {
            "present": true,
            "value": "<b>发现</b>一张<i>（其他职业的）</i>\n武器牌。"
          },
          "zhTW": {
            "present": true,
            "value": "<b>發現</b>一個\n<i>其它職業</i>的武器"
          }
        },
        "textContent": "\n\t\t\t<b>Entdeckt</b> eine Waffe einer anderen Klasse.\n\t\t\t<b>Discover</b> a weapon <i>(from another class)</i>.\n\t\t\t<b>Descubre</b> un arma\n<i>(de otra clase)</i>.\n\t\t\t<b>Devela</b> un arma \n<i>(de otra clase)</i>.\n\t\t\t<b>Découvre</b> une arme\n<i>(d’une autre classe)</i>.\n\t\t\t<b>Rinvieni</b> un'Arma di un'altra classe.\n\t\t\t[x]<i>他のクラスの</i>\n武器を1つ<b>発見</b>する。\n\t\t\t다른 직업의 무기를 <b>발견</b>합니다.\n\t\t\t<b>Odkryj</b> broń\n<i>(innej_klasy)</i>.\n\t\t\t<b>Descubra</b> uma arma <i>(de outra classe)</i>.\n\t\t\tВы <b>раскапываете</b> оружие <i>(другого класса)</i>.\n\t\t\t<b>ค้นพบ</b> อาวุธหนึ่งใบ <i>(ของคลาสอื่น)</i>\n\t\t\t<b>发现</b>一张<i>（其他职业的）</i>\n武器牌。\n\t\t\t<b>發現</b>一個\n<i>其它職業</i>的武器\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Besonders beliebt unter Schurken: der Fünffingerrabatt."
          },
          "enUS": {
            "present": true,
            "value": "Because Thrall wouldn't <i>lend</i> me Doomhammer."
          },
          "esES": {
            "present": true,
            "value": "Es que Thrall no quiso <i>prestarle</i> el Martillo maldito."
          },
          "esMX": {
            "present": true,
            "value": "Porque Thrall no quería <i>prestarme</i> el Martillo maldito."
          },
          "frFR": {
            "present": true,
            "value": "Tout ça parce que Thrall n’a pas voulu lui <i>prêter</i> Marteau-du-Destin."
          },
          "itIT": {
            "present": true,
            "value": "Be', Thrall non ha voluto neanche <i> prestarmi</i> Martelfato."
          },
          "jaJP": {
            "present": true,
            "value": "だってスロールは貸してくれん思ったばーよ、ドゥームハンマーは。"
          },
          "koKR": {
            "present": true,
            "value": "스랄이 둠해머를 빌려줄 리는 없다보니..."
          },
          "plPL": {
            "present": true,
            "value": "Bo Thrall nie chciał <i>wypożyczyć</i> Zgładziciela."
          },
          "ptBR": {
            "present": true,
            "value": "Thrall não quis me <i>emprestar</i> o Martelo da Perdição."
          },
          "ruRU": {
            "present": true,
            "value": "Раз Тралл не захотел одолжить Молот Рока по-хорошему..."
          },
          "thTH": {
            "present": true,
            "value": "ในเมื่อธรอลไม่ยอมให้ข้า *ยืม* ดูมแฮมเมอร์"
          },
          "zhCN": {
            "present": true,
            "value": "谁叫萨尔不肯<i>借</i>我毁灭之锤的。"
          },
          "zhTW": {
            "present": true,
            "value": "誰叫索爾不肯<i>借</i>我末日錘。"
          }
        },
        "textContent": "\n\t\t\tBesonders beliebt unter Schurken: der Fünffingerrabatt.\n\t\t\tBecause Thrall wouldn't <i>lend</i> me Doomhammer.\n\t\t\tEs que Thrall no quiso <i>prestarle</i> el Martillo maldito.\n\t\t\tPorque Thrall no quería <i>prestarme</i> el Martillo maldito.\n\t\t\tTout ça parce que Thrall n’a pas voulu lui <i>prêter</i> Marteau-du-Destin.\n\t\t\tBe', Thrall non ha voluto neanche <i> prestarmi</i> Martelfato.\n\t\t\tだってスロールは貸してくれん思ったばーよ、ドゥームハンマーは。\n\t\t\t스랄이 둠해머를 빌려줄 리는 없다보니...\n\t\t\tBo Thrall nie chciał <i>wypożyczyć</i> Zgładziciela.\n\t\t\tThrall não quis me <i>emprestar</i> o Martelo da Perdição.\n\t\t\tРаз Тралл не захотел одолжить Молот Рока по-хорошему...\n\t\t\tในเมื่อธรอลไม่ยอมให้ข้า *ยืม* ดูมแฮมเมอร์\n\t\t\t谁叫萨尔不肯<i>借</i>我毁灭之锤的。\n\t\t\t誰叫索爾不肯<i>借</i>我末日錘。\n\t\t"
      },
