      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "[x]Verursacht $2 Schaden.\n<b>Überwältigen:</b> Beschwört\nein Basistotem."
          },
          "enUS": {
            "present": true,
            "value": "Deal $2 damage. <b>Overkill</b>: Summon a basic Totem."
          },
          "esES": {
            "present": true,
            "value": "[x]Inflige $2 p. de daño.\n<b>Arrasar:</b> Invoca\nun tótem básico."
          },
          "esMX": {
            "present": true,
            "value": "Inflige $2 de daño. <b>Arrasar</b>: invoca un Tótem básico."
          },
          "frFR": {
            "present": true,
            "value": "Inflige $2_|4(point,points) de dégâts.\n<b>Brutalité :</b> invoque un totem de base."
          },
          "itIT": {
            "present": true,
            "value": "[x]Infligge $2 danni.\n<b>Annientamento:</b>\nevoca un Totem base."
          },
          "jaJP": {
            "present": true,
            "value": "[x]$2ダメージを与える。\n<b>血祭:</b>\n基本のトーテムを\n1体召喚する。"
          },
          "koKR": {
            "present": true,
            "value": "[x]피해를 $2 줍니다.\n<b>압살</b>: 무작위 기본\n토템을 소환합니다."
          },
          "plPL": {
            "present": true,
            "value": "Zadaj $2 pkt. obrażeń.\n<b>Rzeź:</b> Przyzwij podstawowy Totem."
          },
          "ptBR": {
            "present": true,
            "value": "Cause $2 de dano. <b>Massacre:</b> Evoque um Totem básico."
          },
          "ruRU": {
            "present": true,
            "value": "Наносит $2_ед. урона. <b>Сверхурон:</b> призывает базовый тотем."
          },
          "thTH": {
            "present": true,
            "value": "สร้างความเสียหาย_$2_แต้ม <b>สังหารโหด</b>:_เรียกโทเท็ม[b]พื้นฐานหนึ่งอัน"
          },
          "zhCN": {
            "present": true,
            "value": "造成$2点伤害。\n<b>超杀</b>：召唤一个\n基础图腾。"
          },
          "zhTW": {
            "present": true,
            "value": "造成$2點\n傷害。<b>滅殺</b>：召喚一個基本圖騰"
          }
        },
        "textContent": "\n\t\t\t[x]Verursacht $2 Schaden.\n<b>Überwältigen:</b> Beschwört\nein Basistotem.\n\t\t\tDeal $2 damage. <b>Overkill</b>: Summon a basic Totem.\n\t\t\t[x]Inflige $2 p. de daño.\n<b>Arrasar:</b> Invoca\nun tótem básico.\n\t\t\tInflige $2 de daño. <b>Arrasar</b>: invoca un Tótem básico.\n\t\t\tInflige $2_|4(point,points) de dégâts.\n<b>Brutalité :</b> invoque un totem de base.\n\t\t\t[x]Infligge $2 danni.\n<b>Annientamento:</b>\nevoca un Totem base.\n\t\t\t[x]$2ダメージを与える。\n<b>血祭:</b>\n基本のトーテムを\n1体召喚する。\n\t\t\t[x]피해를 $2 줍니다.\n<b>압살</b>: 무작위 기본\n토템을 소환합니다.\n\t\t\tZadaj $2 pkt. obrażeń.\n<b>Rzeź:</b> Przyzwij podstawowy Totem.\n\t\t\tCause $2 de dano. <b>Massacre:</b> Evoque um Totem básico.\n\t\t\tНаносит $2_ед. урона. <b>Сверхурон:</b> призывает базовый тотем.\n\t\t\tสร้างความเสียหาย_$2_แต้ม <b>สังหารโหด</b>:_เรียกโทเท็ม[b]พื้นฐานหนึ่งอัน\n\t\t\t造成$2点伤害。\n<b>超杀</b>：召唤一个\n基础图腾。\n\t\t\t造成$2點\n傷害。<b>滅殺</b>：召喚一個基本圖騰\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Die Totems fliegen tief, es wird wohl Regen geben."
          },
          "enUS": {
            "present": true,
            "value": "Trolls are the first group to have a totem survive atmospheric re-entry."
          },
          "esES": {
            "present": true,
            "value": "Los trols han sido los primeros en lograr que un tótem sobreviva a la reentrada atmosférica."
          },
          "esMX": {
            "present": true,
            "value": "Los trols son los primeros en lograr el reingreso atmosférico de un tótem con éxito."
          },
          "frFR": {
            "present": true,
            "value": "Je mets les totems où je veux et c’est souvent dans la face !"
          },
          "itIT": {
            "present": true,
            "value": "\"Cara, non è che ci siamo dimenticati il totem acceso?\""
          },
          "jaJP": {
            "present": true,
            "value": "トロルは歴史上初めて、大気圏再突入したトーテムを無事に生還させることに成功した種族である。"
          },
          "koKR": {
            "present": true,
            "value": "트롤들은 대기권을 돌파할 수 있는 토템을 처음으로 발명했습니다."
          },
          "plPL": {
            "present": true,
            "value": "„To ptak? To samolot? Nie, to totem!”."
          },
          "ptBR": {
            "present": true,
            "value": "Os trolls foram os primeiros a conseguir fazer um totem sobreviver a uma reentrada atmosférica."
          },
          "ruRU": {
            "present": true,
            "value": "Аэродинамические свойства тотема делают его идеальным метательным снарядом."
          },
          "thTH": {
            "present": true,
            "value": "โทรลล์เป็นพวกแรกที่นำโทเท็มกลับเข้าสู่ชั้นบรรยากาศได้สำเร็จ"
          },
          "zhCN": {
            "present": true,
            "value": "巨魔是首个掌握了轨道图腾回收技术的种族。"
          },
          "zhTW": {
            "present": true,
            "value": "只有食人妖，才能讓圖騰從天而降！"
          }
        },
        "textContent": "\n\t\t\tDie Totems fliegen tief, es wird wohl Regen geben.\n\t\t\tTrolls are the first group to have a totem survive atmospheric re-entry.\n\t\t\tLos trols han sido los primeros en lograr que un tótem sobreviva a la reentrada atmosférica.\n\t\t\tLos trols son los primeros en lograr el reingreso atmosférico de un tótem con éxito.\n\t\t\tJe mets les totems où je veux et c’est souvent dans la face !\n\t\t\t\"Cara, non è che ci siamo dimenticati il totem acceso?\"\n\t\t\tトロルは歴史上初めて、大気圏再突入したトーテムを無事に生還させることに成功した種族である。\n\t\t\t트롤들은 대기권을 돌파할 수 있는 토템을 처음으로 발명했습니다.\n\t\t\t„To ptak? To samolot? Nie, to totem!”.\n\t\t\tOs trolls foram os primeiros a conseguir fazer um totem sobreviver a uma reentrada atmosférica.\n\t\t\tАэродинамические свойства тотема делают его идеальным метательным снарядом.\n\t\t\tโทรลล์เป็นพวกแรกที่นำโทเท็มกลับเข้าสู่ชั้นบรรยากาศได้สำเร็จ\n\t\t\t巨魔是首个掌握了轨道图腾回收技术的种族。\n\t\t\t只有食人妖，才能讓圖騰從天而降！\n\t\t"
      },
