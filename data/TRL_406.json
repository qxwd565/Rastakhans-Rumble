          },
          "thTH": {
            "present": true,
            "value": "มือปืนสัปหงก"
          },
          "zhCN": {
            "present": true,
            "value": "嗜睡的神枪手"
          },
          "zhTW": {
            "present": true,
            "value": "打瞌睡的槍手"
          }
        },
        "textContent": "\n\t\t\tSchnarchender Schütze\n\t\t\tDozing Marksman\n\t\t\tTirador dormido\n\t\t\tTirador dormilón\n\t\t\tTireur d’élite assoupi\n\t\t\tTiratore Appisolato\n\t\t\tまどろむ狙撃手\n\t\t\t꾸벅거리는 저격수\n\t\t\tDrzemiący strzelec\n\t\t\tAtirador Dorminhoco\n\t\t\tСонный стрелок\n\t\t\tมือปืนสัปหงก\n\t\t\t嗜睡的神枪手\n\t\t\t打瞌睡的槍手\n\t\t"
      },
      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Hat +4 Angriff, wenn er verletzt ist."
          },
          "enUS": {
            "present": true,
            "value": "Has +4 Attack while damaged."
          },
          "esES": {
            "present": true,
            "value": "[x]Tiene +4 p. de ataque\nmientras está dañado."
          },
          "esMX": {
            "present": true,
            "value": "Tiene +4 de Ataque cuando está dañado."
          },
          "frFR": {
            "present": true,
            "value": "A +4 ATQ tant qu’il est blessé."
          },
          "itIT": {
            "present": true,
            "value": "[x]Ha +4 Attacco\nfinché è danneggiato."
          },
          "jaJP": {
            "present": true,
            "value": "ダメージを\n受けている間は\n_攻撃力+4を得る。"
          },
          "koKR": {
            "present": true,
            "value": "피해를 받은 상태면 공격력을 +4 얻습니다."
          },
          "plPL": {
            "present": true,
            "value": "Ma +4 do ataku,\nkiedy jest ranny."
          },
          "ptBR": {
            "present": true,
            "value": "Tem +4 de Ataque enquanto estiver ferido."
          },
          "ruRU": {
            "present": true,
            "value": "Получает +4 к атаке,\nесли у этого существа неполное_здоровье."
          },
          "thTH": {
            "present": true,
            "value": "พลังโจมตี +4 ถ้าพลังชีวิตไม่เต็ม"
          },
          "zhCN": {
            "present": true,
            "value": "受伤时具有\n+4攻击力。"
          },
          "zhTW": {
            "present": true,
            "value": "受傷時+4攻擊力"
          }
        },
        "textContent": "\n\t\t\tHat +4 Angriff, wenn er verletzt ist.\n\t\t\tHas +4 Attack while damaged.\n\t\t\t[x]Tiene +4 p. de ataque\nmientras está dañado.\n\t\t\tTiene +4 de Ataque cuando está dañado.\n\t\t\tA +4 ATQ tant qu’il est blessé.\n\t\t\t[x]Ha +4 Attacco\nfinché è danneggiato.\n\t\t\tダメージを\n受けている間は\n_攻撃力+4を得る。\n\t\t\t피해를 받은 상태면 공격력을 +4 얻습니다.\n\t\t\tMa +4 do ataku,\nkiedy jest ranny.\n\t\t\tTem +4 de Ataque enquanto estiver ferido.\n\t\t\tПолучает +4 к атаке,\nесли у этого существа неполное_здоровье.\n\t\t\tพลังโจมตี +4 ถ้าพลังชีวิตไม่เต็ม\n\t\t\t受伤时具有\n+4攻击力。\n\t\t\t受傷時+4攻擊力\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Ohne Kaffee geht bei ihm morgens erstmal gar nichts."
          },
          "enUS": {
            "present": true,
            "value": "It's the sleeper of the set."
          },
          "esES": {
            "present": true,
            "value": "¡Imagínate si estuviese despierto!"
          },
          "esMX": {
            "present": true,
            "value": "La verdad es que lo habíamos echado del kit, pero cuando volvimos seguía ahí."
          },
          "frFR": {
            "present": true,
            "value": "Le dormeur doit se réveiller."
          },
          "itIT": {
            "present": true,
            "value": "\"Dai, mamma, solo altri cinque minuti...\""
          },
          "jaJP": {
            "present": true,
            "value": "いつも首筋がチクッとすると急に眠くなり、まどろんでいるうちにターゲットが死んでいるという、名狙撃手なんだ。"
          },
          "koKR": {
            "present": true,
            "value": "하품이 절로 나오는 카드군요."
          },
          "plPL": {
            "present": true,
            "value": "Twierdzi, że trafia nawet we śnie."
          },
          "ptBR": {
            "present": true,
            "value": "Esse aí tem um sono de chumbo."
          },
          "ruRU": {
            "present": true,
            "value": "Стрелок спит — служба идет."
          },
          "thTH": {
            "present": true,
            "value": "ตอนนี้ยังไม่ได้ตื่นเลยจะสิบโมงเช้า"
          },
          "zhCN": {
            "present": true,
            "value": "当前版本的特困生。"
          },
          "zhTW": {
            "present": true,
            "value": "裝睡的人叫不醒。"
          }
        },
        "textContent": "\n\t\t\tOhne Kaffee geht bei ihm morgens erstmal gar nichts.\n\t\t\tIt's the sleeper of the set.\n\t\t\t¡Imagínate si estuviese despierto!\n\t\t\tLa verdad es que lo habíamos echado del kit, pero cuando volvimos seguía ahí.\n\t\t\tLe dormeur doit se réveiller.\n\t\t\t\"Dai, mamma, solo altri cinque minuti...\"\n\t\t\tいつも首筋がチクッとすると急に眠くなり、まどろんでいるうちにターゲットが死んでいるという、名狙撃手なんだ。\n\t\t\t하품이 절로 나오는 카드군요.\n\t\t\tTwierdzi, że trafia nawet we śnie.\n\t\t\tEsse aí tem um sono de chumbo.\n\t\t\tСтрелок спит — служба идет.\n\t\t\tตอนนี้ยังไม่ได้ตื่นเลยจะสิบโมงเช้า\n\t\t\t当前版本的特困生。\n\t\t\t裝睡的人叫不醒。\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Sean McNally"
      }
    },
