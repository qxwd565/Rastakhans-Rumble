        "locales": {
          "deDE": {
            "present": true,
            "value": "..._ist eingetroffen? Wird gesucht? Will ein Stück Kuchen? Nun macht es doch nicht so spannend!"
          },
          "enUS": {
            "present": true,
            "value": "… Arrives? Approaches? TELL US ALREADY!"
          },
          "esES": {
            "present": true,
            "value": "Descubridor de talentos."
          },
          "esMX": {
            "present": true,
            "value": "… ¿Llega? ¿Se aproxima? ¡DINOS DE UNA VEZ!"
          },
          "frFR": {
            "present": true,
            "value": "… apparaît ? Veut se battre ? Parlez, nom d’un Troll !"
          },
          "itIT": {
            "present": true,
            "value": "Neanche noi siamo sicuri che sia previsto dal regolamento."
          },
          "jaJP": {
            "present": true,
            "value": "新手のロア使いか！"
          },
          "koKR": {
            "present": true,
            "value": "...설마 '그' 도전자는 아니겠죠?"
          },
          "plPL": {
            "present": true,
            "value": "„... przyłapany na dopingu? Zrezygnował z zawodów? ŻĄDAMY INFORMACJI!”."
          },
          "ptBR": {
            "present": true,
            "value": "... Entra? Se aproxima? FALA LOGO!"
          },
          "ruRU": {
            "present": true,
            "value": "Пришел. Увидел. Наследил."
          },
          "thTH": {
            "present": true,
            "value": "...มาแล้ว? ปรากฏกาย? พูดต่อให้จบสิ!"
          },
          "zhCN": {
            "present": true,
            "value": "江山代有毒瘤出，各领天梯好几年。"
          },
          "zhTW": {
            "present": true,
            "value": "「…來了？來了嗎？把話說完啊！」"
          }
        },
        "textContent": "\n\t\t..._ist eingetroffen? Wird gesucht? Will ein Stück Kuchen? Nun macht es doch nicht so spannend!\n\t\t… Arrives? Approaches? TELL US ALREADY!\n\t\tDescubridor de talentos.\n\t\t… ¿Llega? ¿Se aproxima? ¡DINOS DE UNA VEZ!\n\t\t… apparaît ? Veut se battre ? Parlez, nom d’un Troll !\n\t\tNeanche noi siamo sicuri che sia previsto dal regolamento.\n\t\t新手のロア使いか！\n\t\t...설마 '그' 도전자는 아니겠죠?\n\t\t„... przyłapany na dopingu? Zrezygnował z zawodów? ŻĄDAMY INFORMACJI!”.\n\t\t... Entra? Se aproxima? FALA LOGO!\n\t\tПришел. Увидел. Наследил.\n\t\t...มาแล้ว? ปรากฏกาย? พูดต่อให้จบสิ!\n\t\t江山代有毒瘤出，各领天梯好几年。\n\t\t「…來了？來了嗎？把話說完啊！」\n\t"
      },
