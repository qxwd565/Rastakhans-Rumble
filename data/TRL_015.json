        "textContent": "\n\t\t\tTicketvertickerin\n\t\t\tTicket Scalper\n\t\t\tRevendedora de entradas\n\t\t\tRevendedora de boletos\n\t\t\tFourgue-billets\n\t\t\tBagarina Troll\n\t\t\tダフ屋\n\t\t\t암표 흥정꾼\n\t\t\tChytry konik\n\t\t\tCambista Careira\n\t\t\tБилетная спекулянтка\n\t\t\tคนขายตั๋วผี\n\t\t\t黑心票贩\n\t\t\t黃牛票販子\n\t\t"
      },
      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Überwältigen:</b>\nZieht 2 Karten."
          },
          "enUS": {
            "present": true,
            "value": "<b>Overkill</b>: Draw 2 cards."
          },
          "esES": {
            "present": true,
            "value": "[x]<b>Arrasar:</b>\nRoba 2 cartas."
          },
          "esMX": {
            "present": true,
            "value": "<b>Arrasar</b>: roba 2 cartas."
          },
          "frFR": {
            "present": true,
            "value": "<b>Brutalité :</b> vous piochez 2_cartes."
          },
          "itIT": {
            "present": true,
            "value": "[x]<b>Annientamento:</b>\npesca 2 carte."
          },
          "jaJP": {
            "present": true,
            "value": "<b>血祭:</b>\n_カードを2枚引く。"
          },
          "koKR": {
            "present": true,
            "value": "<b>압살:</b>\n카드를 2장 뽑습니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Rzeź:</b> Dobierz 2 karty."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Massacre:</b>\nCompre 2 cards."
          },
          "ruRU": {
            "present": true,
            "value": "<b>Сверхурон:</b> вы берете 2_карты."
          },
          "thTH": {
            "present": true,
            "value": "<b>สังหารโหด</b>: จั่วการ์ด_2_ใบ"
          },
          "zhCN": {
            "present": true,
            "value": "<b>超杀</b>：抽两张牌。"
          },
          "zhTW": {
            "present": true,
            "value": "<b>滅殺</b>：抽2張牌"
          }
        },
        "textContent": "\n\t\t\t<b>Überwältigen:</b>\nZieht 2 Karten.\n\t\t\t<b>Overkill</b>: Draw 2 cards.\n\t\t\t[x]<b>Arrasar:</b>\nRoba 2 cartas.\n\t\t\t<b>Arrasar</b>: roba 2 cartas.\n\t\t\t<b>Brutalité :</b> vous piochez 2_cartes.\n\t\t\t[x]<b>Annientamento:</b>\npesca 2 carte.\n\t\t\t<b>血祭:</b>\n_カードを2枚引く。\n\t\t\t<b>압살:</b>\n카드를 2장 뽑습니다.\n\t\t\t<b>Rzeź:</b> Dobierz 2 karty.\n\t\t\t<b>Massacre:</b>\nCompre 2 cards.\n\t\t\t<b>Сверхурон:</b> вы берете 2_карты.\n\t\t\t<b>สังหารโหด</b>: จั่วการ์ด_2_ใบ\n\t\t\t<b>超杀</b>：抽两张牌。\n\t\t\t<b>滅殺</b>：抽2張牌\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Bei den Preisen könnte man meinen, sie tickt nicht ganz richtig."
          },
          "enUS": {
            "present": true,
            "value": "Takes ten percent off the top."
          },
          "esES": {
            "present": true,
            "value": "Vigila que no hayan imprimido las entradas en galletas."
          },
          "esMX": {
            "present": true,
            "value": "¿Te sientes estafado? Agradece si solo se queda con tu dinero."
          },
          "frFR": {
            "present": true,
            "value": "N’oubliez pas sa marge de 10% !"
          },
          "itIT": {
            "present": true,
            "value": "Sconto del 10% sul prezzo maggiorato del 200%."
          },
          "jaJP": {
            "present": true,
            "value": "ダフ屋から買った手札はマナコストが10倍以上になることもあるから、うかつに手を出すなよ。"
          },
          "koKR": {
            "present": true,
            "value": "웃돈은 10% 정도만 준비해."
          },
          "plPL": {
            "present": true,
            "value": "„Może bilecik? Przysięgam, że z nikogo nie zdzieram!”."
          },
          "ptBR": {
            "present": true,
            "value": "Tira dez por cento em cima."
          },
          "ruRU": {
            "present": true,
            "value": "«Вот на эти два процента я и живу»."
          },
          "thTH": {
            "present": true,
            "value": "ตั๋วไม่หลอก แต่คนขายน่ะไม่แน่"
          },
          "zhCN": {
            "present": true,
            "value": "按原价的三倍出售！"
          },
          "zhTW": {
            "present": true,
            "value": "每人最多只能購買4張票。"
          }
        },
        "textContent": "\n\t\t\tBei den Preisen könnte man meinen, sie tickt nicht ganz richtig.\n\t\t\tTakes ten percent off the top.\n\t\t\tVigila que no hayan imprimido las entradas en galletas.\n\t\t\t¿Te sientes estafado? Agradece si solo se queda con tu dinero.\n\t\t\tN’oubliez pas sa marge de 10% !\n\t\t\tSconto del 10% sul prezzo maggiorato del 200%.\n\t\t\tダフ屋から買った手札はマナコストが10倍以上になることもあるから、うかつに手を出すなよ。\n\t\t\t웃돈은 10% 정도만 준비해.\n\t\t\t„Może bilecik? Przysięgam, że z nikogo nie zdzieram!”.\n\t\t\tTira dez por cento em cima.\n\t\t\t«Вот на эти два процента я и живу».\n\t\t\tตั๋วไม่หลอก แต่คนขายน่ะไม่แน่\n\t\t\t按原价的三倍出售！\n\t\t\t每人最多只能購買4張票。\n\t\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "David Kegg"
      }
