      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Überwältigen:</b>\nErhält +5 Angriff."
          },
          "enUS": {
            "present": true,
            "value": "<b>Overkill:</b> Gain +5 Attack."
          },
          "esES": {
            "present": true,
            "value": "<b>Arrasar:</b>\nObtiene +5 p. de ataque."
          },
          "esMX": {
            "present": true,
            "value": "<b>Arrasar:</b> obtiene +5 de Ataque."
          },
          "frFR": {
