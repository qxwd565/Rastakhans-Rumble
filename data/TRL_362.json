      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Erhaltet 2 zufällige Drachen auf die Hand."
          },
          "enUS": {
            "present": true,
            "value": "Add 2 random Dragons to your hand."
          },
          "esES": {
            "present": true,
            "value": "[x]Añade 2 dragones aleatorios\na tu mano."
          },
          "esMX": {
            "present": true,
            "value": "Agrega 2 Dragones aleatorios a tu mano."
          },
          "frFR": {
            "present": true,
            "value": "Ajoute 2_Dragons aléatoires dans votre main."
          },
          "itIT": {
            "present": true,
            "value": "Mette nella tua mano due Draghi casuali."
          },
          "jaJP": {
            "present": true,
            "value": "[x]ランダムなドラゴン\n2体を自分の手札に\n追加する。"
          },
          "koKR": {
            "present": true,
            "value": "무작위 용족 둘을 내 손으로 가져옵니다."
          },
          "plPL": {
            "present": true,
            "value": "Dodaj dwa losowe Smoki do twojej ręki."
          },
          "ptBR": {
            "present": true,
            "value": "Adicione 2 Dragões aleatórios à sua mão."
          },
          "ruRU": {
            "present": true,
            "value": "Вы кладете в руку 2_случайных драконов."
          },
          "thTH": {
            "present": true,
            "value": "สุ่มเพิ่มการ์ดมังกร 2 ใบในมือคุณ"
          },
          "zhCN": {
            "present": true,
            "value": "随机将两张龙牌置入你的手牌。"
          },
          "zhTW": {
            "present": true,
            "value": "放2個隨機\n龍類到你的手中"
          }
        },
        "textContent": "\n\t\t\tErhaltet 2 zufällige Drachen auf die Hand.\n\t\t\tAdd 2 random Dragons to your hand.\n\t\t\t[x]Añade 2 dragones aleatorios\na tu mano.\n\t\t\tAgrega 2 Dragones aleatorios a tu mano.\n\t\t\tAjoute 2_Dragons aléatoires dans votre main.\n\t\t\tMette nella tua mano due Draghi casuali.\n\t\t\t[x]ランダムなドラゴン\n2体を自分の手札に\n追加する。\n\t\t\t무작위 용족 둘을 내 손으로 가져옵니다.\n\t\t\tDodaj dwa losowe Smoki do twojej ręki.\n\t\t\tAdicione 2 Dragões aleatórios à sua mão.\n\t\t\tВы кладете в руку 2_случайных драконов.\n\t\t\tสุ่มเพิ่มการ์ดมังกร 2 ใบในมือคุณ\n\t\t\t随机将两张龙牌置入你的手牌。\n\t\t\t放2個隨機\n龍類到你的手中\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "„Drachen, die brüllen, beißen nicht.“ Wer das glaubt, der lässt sich auch einreden, Goblintechnologie sei vollkommen ungefährlich."
          },
          "enUS": {
            "present": true,
            "value": "Not to be confused with Dragon Yodel."
          },
          "esES": {
            "present": true,
            "value": "Sabemos que, una vez que lo oigas, no te vas a quedar para saber de quién es."
          },
          "esMX": {
            "present": true,
            "value": "No debe confundirse con el canto tirolés de dragón."
          },
          "frFR": {
            "present": true,
            "value": "Je suis un dragon, écoutez-moi rugir !"
          },
          "itIT": {
            "present": true,
            "value": "Da non confondere col Grugnito del Drago."
          },
          "jaJP": {
            "present": true,
            "value": "ドラゴンの炎で焙られたら、思わず「アチャーッ！」って叫んじまっても仕方ないよな。"
          },
          "koKR": {
            "present": true,
            "value": "용의 요들과는 다릅니다."
          },
          "plPL": {
            "present": true,
            "value": "Hipsterskie smoki wolą jodłowanie."
          },
          "ptBR": {
            "present": true,
            "value": "Não confundir com \"Mugido de Dragão\"."
          },
          "ruRU": {
            "present": true,
            "value": "Что может быть хуже, чем встретить дракона? Встретить двух драконов."
          },
          "thTH": {
            "present": true,
            "value": "ถ้าเป็นเสียงกิ้งก่ากิ้งกือจะเรียกว่าแหล่"
          },
          "zhCN": {
            "present": true,
            "value": "听起来就像是巨龙在练习约德尔唱法。"
          },
          "zhTW": {
            "present": true,
            "value": "「去吧~龍啊~去吧~」\n「就去吧~就飛吧」\n「在天空飛翔吧」"
          }
        },
        "textContent": "\n\t\t\t„Drachen, die brüllen, beißen nicht.“ Wer das glaubt, der lässt sich auch einreden, Goblintechnologie sei vollkommen ungefährlich.\n\t\t\tNot to be confused with Dragon Yodel.\n\t\t\tSabemos que, una vez que lo oigas, no te vas a quedar para saber de quién es.\n\t\t\tNo debe confundirse con el canto tirolés de dragón.\n\t\t\tJe suis un dragon, écoutez-moi rugir !\n\t\t\tDa non confondere col Grugnito del Drago.\n\t\t\tドラゴンの炎で焙られたら、思わず「アチャーッ！」って叫んじまっても仕方ないよな。\n\t\t\t용의 요들과는 다릅니다.\n\t\t\tHipsterskie smoki wolą jodłowanie.\n\t\t\tNão confundir com \"Mugido de Dragão\".\n\t\t\tЧто может быть хуже, чем встретить дракона? Встретить двух драконов.\n\t\t\tถ้าเป็นเสียงกิ้งก่ากิ้งกือจะเรียกว่าแหล่\n\t\t\t听起来就像是巨龙在练习约德尔唱法。\n\t\t\t「去吧~龍啊~去吧~」\n「就去吧~就飛吧」\n「在天空飛翔吧」\n\t\t"
      },
