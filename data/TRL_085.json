      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "Jedes Mal, wenn Ihr einen Zauber auf einen Diener wirkt, wird er auch auf benachbarte Diener gewirkt."
          },
          "enUS": {
            "present": true,
            "value": "[x]Whenever you target a\nminion with a spell, it also\ntargets adjacent ones."
          },
          "esES": {
            "present": true,
            "value": "[x]Cada vez que lanzas\nun hechizo a un esbirro,\ntambién afecta a los esbirros\nadyacentes."
          },
          "esMX": {
            "present": true,
            "value": "Cada vez que usas un hechizo sobre un esbirro, también afecta a los esbirros adyacentes."
          },
          "frFR": {
            "present": true,
            "value": "Chaque fois que vous ciblez un serviteur avec un sort, vise aussi les serviteurs adjacents."
          },
          "itIT": {
            "present": true,
            "value": "[x]Quando lanci una Magia\nsu un servitore, viene\nlanciata anche su\nquelli adiacenti."
          },
          "jaJP": {
            "present": true,
            "value": "[x]自分がミニオン1体に\n対して呪文を使用する度\n隣接するミニオンも\n対象にする。"
          },
          "koKR": {
            "present": true,
            "value": "[x]내가 주문의 대상으로\n하수인을 지정할 때마다\n양옆의 하수인들도\n대상으로 지정합니다."
          },
          "plPL": {
            "present": true,
            "value": "Za każdym razem gdy rzucasz zaklęcie na stronnika, jego sąsiedzi również stają się celami."
          },
          "ptBR": {
            "present": true,
            "value": "Sempre que você alvejar um lacaio com um feitiço, ele também atingirá os adjacentes."
          },
          "ruRU": {
            "present": true,
            "value": "Когда вы выбираете целью заклинания существо, целями становятся и существа по обе стороны от него."
          },
          "thTH": {
            "present": true,
            "value": "ทุกครั้งที่คุณเลือกมินเนี่ยน[b]เป็นเป้าหมายของเวทมนตร์ มินเนี่ยนที่อยู่ติดกันจะถูก[b]เลือกเป็นเป้าหมายด้วย"
          },
          "zhCN": {
            "present": true,
            "value": "每当你以一个随从为目标施放法术时，该随从相邻的随从同时成为法术的目标。"
          },
          "zhTW": {
            "present": true,
            "value": "每當你對手下施放法術，同時對其兩側的手下產生效果"
          }
        },
        "textContent": "\n\t\t\tJedes Mal, wenn Ihr einen Zauber auf einen Diener wirkt, wird er auch auf benachbarte Diener gewirkt.\n\t\t\t[x]Whenever you target a\nminion with a spell, it also\ntargets adjacent ones.\n\t\t\t[x]Cada vez que lanzas\nun hechizo a un esbirro,\ntambién afecta a los esbirros\nadyacentes.\n\t\t\tCada vez que usas un hechizo sobre un esbirro, también afecta a los esbirros adyacentes.\n\t\t\tChaque fois que vous ciblez un serviteur avec un sort, vise aussi les serviteurs adjacents.\n\t\t\t[x]Quando lanci una Magia\nsu un servitore, viene\nlanciata anche su\nquelli adiacenti.\n\t\t\t[x]自分がミニオン1体に\n対して呪文を使用する度\n隣接するミニオンも\n対象にする。\n\t\t\t[x]내가 주문의 대상으로\n하수인을 지정할 때마다\n양옆의 하수인들도\n대상으로 지정합니다.\n\t\t\tZa każdym razem gdy rzucasz zaklęcie na stronnika, jego sąsiedzi również stają się celami.\n\t\t\tSempre que você alvejar um lacaio com um feitiço, ele também atingirá os adjacentes.\n\t\t\tКогда вы выбираете целью заклинания существо, целями становятся и существа по обе стороны от него.\n\t\t\tทุกครั้งที่คุณเลือกมินเนี่ยน[b]เป็นเป้าหมายของเวทมนตร์ มินเนี่ยนที่อยู่ติดกันจะถูก[b]เลือกเป็นเป้าหมายด้วย\n\t\t\t每当你以一个随从为目标施放法术时，该随从相邻的随从同时成为法术的目标。\n\t\t\t每當你對手下施放法術，同時對其兩側的手下產生效果\n\t\t"
      },
      "351": {
        "present": true,
