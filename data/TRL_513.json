          },
          "koKR": {
            "present": true,
            "value": "<b>도발</b>\n<b>천상의 보호막</b>"
          },
          "plPL": {
            "present": true,
            "value": "<b>Prowokacja</b>\n<b>Boska tarcza</b>"
          },
          "ptBR": {
            "present": true,
            "value": "<b>Provocar</b>\n<b>Escudo Divino</b>"
          },
          "ruRU": {
