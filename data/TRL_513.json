            "value": "<b>Провокация</b>\n<b>Божественный щит</b>"
          },
          "thTH": {
            "present": true,
            "value": "<b>ยั่วยุ</b>\n<b>โล่ศักดิ์สิทธิ์</b>"
          },
          "zhCN": {
            "present": true,
            "value": "<b>嘲讽</b>\n<b>圣盾</b>"
          },
          "zhTW": {
