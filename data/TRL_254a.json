            "value": "Donne <b>Provocation</b> et +2/+4 à un serviteur."
          },
          "itIT": {
            "present": true,
            "value": "+2/+4 e <b>Provocazione</b> a un servitore."
          },
          "jaJP": {
            "present": true,
            "value": "[x]ミニオン1体に\n+2/+4と<b>挑発</b>を\n付与する。"
          },
          "koKR": {
            "present": true,
            "value": "하수인에게 +2/+4와 <b>도발</b>을 부여합니다."
          },
          "plPL": {
            "present": true,
            "value": "Daj stronnikowi +2/+4 oraz <b>Prowokację</b>."
          },
          "ptBR": {
            "present": true,
            "value": "Conceda +2/+4 e <b>Provocar</b> a um lacaio."
          },
          "ruRU": {
            "present": true,
            "value": "Выбранное существо получает +2/+4 и <b>«Провокацию»</b>."
          },
          "thTH": {
            "present": true,
            "value": "มอบ +2/+4 และ <b>ยั่วยุ</b> ให้มินเนี่ยนหนึ่งตัว"
          },
          "zhCN": {
            "present": true,
            "value": "使一个随从获得+2/+4并\n具有<b>嘲讽</b>。"
