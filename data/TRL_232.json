            "value": "„Junge! Bring mir meine Maske und meine Schädelramme.“"
          },
          "enUS": {
            "present": true,
            "value": "\"Boy! Bring me my masks and skull rams.\""
          },
          "esES": {
            "present": true,
            "value": "«¡Chico! Tráeme mis máscaras y mis calaveras»."
          },
          "esMX": {
            "present": true,
            "value": "\"¡Niño! Tráeme mis máscaras y calaveras de carnero\"."
          },
          "frFR": {
            "present": true,
            "value": "« Hé, toi là ! Apporte-moi mon masque et mes crânes-béliers ! »"
          },
          "itIT": {
            "present": true,
            "value": "\"Ragazzo! Portami le maschere e gli arieti a teschio.\""
          },
          "jaJP": {
            "present": true,
            "value": "ダイアホーンは実は別の恐竜の幼体だった、って言ってた連中はみんな、ダイアホーンの幼体を呼び出す生贄になっちまったのさ。"
          },
          "koKR": {
            "present": true,
            "value": "\"아들아! 내 가면과 공성추를 가져오너라.\""
          },
          "plPL": {
            "present": true,
            "value": "„Chłopcze! Przynieś mi maskę i czaszkowe tarany!”."
          },
          "ptBR": {
            "present": true,
            "value": "\"Filho! Me traz as máscaras e caveiras.\""
          },
          "ruRU": {
            "present": true,
            "value": "На самом деле он очень чуткий и отзывчивый."
          },
          "thTH": {
            "present": true,
            "value": "\"ไอ้หนู! ไปเอาหน้ากากกับหัวกะโหลกมา\""
          },
          "zhCN": {
            "present": true,
            "value": "超杀亲兄弟，上阵父子兵。"
          },
          "zhTW": {
            "present": true,
            "value": "「兒子！快過來幫忙！」"
          }
        },
        "textContent": "\n\t\t„Junge! Bring mir meine Maske und meine Schädelramme.“\n\t\t\"Boy! Bring me my masks and skull rams.\"\n\t\t«¡Chico! Tráeme mis máscaras y mis calaveras».\n\t\t\"¡Niño! Tráeme mis máscaras y calaveras de carnero\".\n\t\t« Hé, toi là ! Apporte-moi mon masque et mes crânes-béliers ! »\n\t\t\"Ragazzo! Portami le maschere e gli arieti a teschio.\"\n\t\tダイアホーンは実は別の恐竜の幼体だった、って言ってた連中はみんな、ダイアホーンの幼体を呼び出す生贄になっちまったのさ。\n\t\t\"아들아! 내 가면과 공성추를 가져오너라.\"\n\t\t„Chłopcze! Przynieś mi maskę i czaszkowe tarany!”.\n\t\t\"Filho! Me traz as máscaras e caveiras.\"\n\t\tНа самом деле он очень чуткий и отзывчивый.\n\t\t\"ไอ้หนู! ไปเอาหน้ากากกับหัวกะโหลกมา\"\n\t\t超杀亲兄弟，上阵父子兵。\n\t\t「兒子！快過來幫忙！」\n\t"
      },
      "342": {
        "present": true,
        "type": "String",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {},
        "textContent": "Luca Zontini"
      }
    },
