        "textContent": "\n\t\t\tEisenhautterrorhorn\n\t\t\tIronhide Direhorn\n\t\t\tCuernoatroz pielférrea\n\t\t\tCuernoatroz pielférrea\n\t\t\tNavrecorne cuiracier\n\t\t\tCornofurente Pelleferrea\n\t\t\tアイアンハイド・ダイアホーン\n\t\t\t무쇠가죽 공포뿔\n\t\t\tŻelaznoskóry złorożec\n\t\t\tEscornante Couro-de-Ferro\n\t\t\tТолстокожий дикорог\n\t\t\tไดร์ฮอร์นผิวเหล็ก\n\t\t\t铁皮恐角龙\n\t\t\t鐵皮恐角龍\n\t\t"
      },
      "184": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "<b>Überwältigen:</b> Ruft ein Eisenhautjunges (5/5) herbei."
          },
          "enUS": {
            "present": true,
            "value": "<b>Overkill:</b> Summon a 5/5_Ironhide Runt."
          },
          "esES": {
            "present": true,
            "value": "[x]<b>Arrasar:</b> Invoca a un\n pielférrea enano 5/5."
          },
          "esMX": {
            "present": true,
            "value": "<b>Arrasar:</b> invoca una Cría pielférrea 5/5."
          },
          "frFR": {
            "present": true,
            "value": "<b>Brutalité :</b> invoque un rejeton cuiracier_5/5."
          },
          "itIT": {
            "present": true,
            "value": "<b>Annientamento:</b>\nevoca un Cucciolo Pelleferrea 5/5."
          },
          "jaJP": {
            "present": true,
            "value": "[x]<b>血祭:</b>\n5/5の\n「アイアンハイドのチビ」を\n1体召喚する。"
          },
          "koKR": {
            "present": true,
            "value": "<b>압살:</b> 5/5 새끼 무쇠가죽 공포뿔을 소환합니다."
          },
          "plPL": {
            "present": true,
            "value": "<b>Rzeź:</b> Przyzwij Żelaznoskóre pisklę 5/5."
          },
          "ptBR": {
            "present": true,
            "value": "<b>Massacre:</b> Evoque um Couro-de-Ferro \nNanico 5/5."
          },
          "ruRU": {
            "present": true,
            "value": "<b>Сверхурон:</b> призывает толстокожего дикорожка 5/5."
          },
          "thTH": {
            "present": true,
            "value": "<b>สังหารโหด:</b> เรียก[b]ไดร์ฮอร์นตัวจิ๋ว_5/5"
          },
          "zhCN": {
            "present": true,
            "value": "<b>超杀：</b>召唤一个5/5的铁皮小恐龙。"
          },
          "zhTW": {
            "present": true,
            "value": "<b>滅殺：</b>召喚一個\n5/5鐵皮小恐角龍"
          }
        },
        "textContent": "\n\t\t\t<b>Überwältigen:</b> Ruft ein Eisenhautjunges (5/5) herbei.\n\t\t\t<b>Overkill:</b> Summon a 5/5_Ironhide Runt.\n\t\t\t[x]<b>Arrasar:</b> Invoca a un\n pielférrea enano 5/5.\n\t\t\t<b>Arrasar:</b> invoca una Cría pielférrea 5/5.\n\t\t\t<b>Brutalité :</b> invoque un rejeton cuiracier_5/5.\n\t\t\t<b>Annientamento:</b>\nevoca un Cucciolo Pelleferrea 5/5.\n\t\t\t[x]<b>血祭:</b>\n5/5の\n「アイアンハイドのチビ」を\n1体召喚する。\n\t\t\t<b>압살:</b> 5/5 새끼 무쇠가죽 공포뿔을 소환합니다.\n\t\t\t<b>Rzeź:</b> Przyzwij Żelaznoskóre pisklę 5/5.\n\t\t\t<b>Massacre:</b> Evoque um Couro-de-Ferro \nNanico 5/5.\n\t\t\t<b>Сверхурон:</b> призывает толстокожего дикорожка 5/5.\n\t\t\t<b>สังหารโหด:</b> เรียก[b]ไดร์ฮอร์นตัวจิ๋ว_5/5\n\t\t\t<b>超杀：</b>召唤一个5/5的铁皮小恐龙。\n\t\t\t<b>滅殺：</b>召喚一個\n5/5鐵皮小恐角龍\n\t\t"
      },
      "351": {
        "present": true,
        "type": "LocString",
        "valueAttributePresent": false,
        "valueAttribute": null,
        "locales": {
          "deDE": {
            "present": true,
            "value": "„Junge! Bring mir meine Maske und meine Schädelramme.“"
          },
          "enUS": {
            "present": true,
            "value": "\"Boy! Bring me my masks and skull rams.\""
          },
          "esES": {
            "present": true,
            "value": "«¡Chico! Tráeme mis máscaras y mis calaveras»."
          },
          "esMX": {
            "present": true,
            "value": "\"¡Niño! Tráeme mis máscaras y calaveras de carnero\"."
          },
          "frFR": {
            "present": true,
            "value": "« Hé, toi là ! Apporte-moi mon masque et mes crânes-béliers ! »"
          },
          "itIT": {
            "present": true,
            "value": "\"Ragazzo! Portami le maschere e gli arieti a teschio.\""
          },
          "jaJP": {
            "present": true,
            "value": "ダイアホーンは実は別の恐竜の幼体だった、って言ってた連中はみんな、ダイアホーンの幼体を呼び出す生贄になっちまったのさ。"
          },
          "koKR": {
            "present": true,
            "value": "\"아들아! 내 가면과 공성추를 가져오너라.\""
          },
          "plPL": {
            "present": true,
            "value": "„Chłopcze! Przynieś mi maskę i czaszkowe tarany!”."
          },
          "ptBR": {
            "present": true,
            "value": "\"Filho! Me traz as máscaras e caveiras.\""
          },
          "ruRU": {
            "present": true,
            "value": "На самом деле он очень чуткий и отзывчивый."
          },
          "thTH": {
            "present": true,
            "value": "\"ไอ้หนู! ไปเอาหน้ากากกับหัวกะโหลกมา\""
          },
          "zhCN": {
            "present": true,
            "value": "超杀亲兄弟，上阵父子兵。"
          },
          "zhTW": {
            "present": true,
            "value": "「兒子！快過來幫忙！」"
          }
        },
        "textContent": "\n\t\t\t„Junge! Bring mir meine Maske und meine Schädelramme.“\n\t\t\t\"Boy! Bring me my masks and skull rams.\"\n\t\t\t«¡Chico! Tráeme mis máscaras y mis calaveras».\n\t\t\t\"¡Niño! Tráeme mis máscaras y calaveras de carnero\".\n\t\t\t« Hé, toi là ! Apporte-moi mon masque et mes crânes-béliers ! »\n\t\t\t\"Ragazzo! Portami le maschere e gli arieti a teschio.\"\n\t\t\tダイアホーンは実は別の恐竜の幼体だった、って言ってた連中はみんな、ダイアホーンの幼体を呼び出す生贄になっちまったのさ。\n\t\t\t\"아들아! 내 가면과 공성추를 가져오너라.\"\n\t\t\t„Chłopcze! Przynieś mi maskę i czaszkowe tarany!”.\n\t\t\t\"Filho! Me traz as máscaras e caveiras.\"\n\t\t\tНа самом деле он очень чуткий и отзывчивый.\n\t\t\t\"ไอ้หนู! ไปเอาหน้ากากกับหัวกะโหลกมา\"\n\t\t\t超杀亲兄弟，上阵父子兵。\n\t\t\t「兒子！快過來幫忙！」\n\t\t"
      },
      "342": {
        "present": true,
